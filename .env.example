# Copy this file to .env and fill in the values. Never commit .env.
# Real environment variables override this file.

# Optional: server-wide fallback for profiles without their own saved key.
# Keys can also be saved per profile in Settings > Backends & keys.
OPENROUTER_API_KEY=

# Encrypts saved API keys at rest. Use a long passphrase or 64 hex characters.
# Leave blank to auto-generate data/secret.key (back it up with the database).
CLACHAN_SECRET_KEY=

# Optional.
CLACHAN_ADDR=:7654
CLACHAN_DB=./data/clachan.db
DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017
DEFAULT_SYSTEM_PROMPT=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://github.com/SHOWTEX/ClaChan
OPENROUTER_TITLE=Clachan
TAVILY_BASE_URL=https://api.tavily.com
