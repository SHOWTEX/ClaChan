# Copy this file to .env and fill in the values. Never commit .env.
# Real environment variables override this file.

# Required for chatting. Server-side only: the browser never sees this.
OPENROUTER_API_KEY=

# Optional.
CLACHAN_ADDR=:7654
CLACHAN_DB=./data/clachan.db
DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017
DEFAULT_SYSTEM_PROMPT=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://github.com/SHOWTEX/ClaChan
OPENROUTER_TITLE=Clachan
