# Normalize text files in the repository to LF.
* text=auto eol=lf

# Windows scripts keep CRLF so they run correctly in Windows PowerShell.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
